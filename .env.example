# Copy this file to `.env.local` and fill in real values.

# Public origin used in sitemap.xml and robots.txt. Use the canonical site URL.
# (Optional in development; required for accurate sitemap entries in production.)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Giscus comments (optional) ---
# Set up a public GitHub repo with Discussions enabled, install the Giscus
# GitHub App, and visit https://giscus.app to retrieve these four IDs.
# Comments stay disabled until all four are set.
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
